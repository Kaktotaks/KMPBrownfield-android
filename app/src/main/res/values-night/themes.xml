<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tasks" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tasks_bg</item>
        <item name="android:colorBackground">@color/tasks_bg</item>
    </style>

    <!-- Launch frame (splash handoff §2): plain #0A0A0A in light and dark, no icon, no branding. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Tasks</item>
    </style>
</resources>
